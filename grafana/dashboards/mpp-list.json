          "rawSql": "/* mpp-list panel 6 A */ SELECT r.scope_id,r.database,r.execution_user,mpp_view_label('timing',r.timing_type) timing,\n  r.included_count,r.active_days,r.p50_ms,r.p95_ms,r.p99_ms,r.max_ms,r.mean_ms,\n  CASE WHEN r.p99_met THEN '三项都满足' WHEN r.p95_met THEN 'P99 样本不足' WHEN r.basic_met THEN 'P95、P99 样本不足' ELSE '样本不足' END conditions,\n  r.fingerprint,r.ranked_rows,\n  '/d/mpp-detail/sql-detail?var-fp='||r.fingerprint||'&var-identity='||r.identity||'&from='||(extract(epoch FROM h.last_at-interval '7 days')*1000)::bigint||'&to='||(extract(epoch FROM h.last_at+interval '1 millisecond')*1000)::bigint||'&var-timing='||r.timing_type AS url\nFROM mpp_view_baseline_ranking('${norm}',mpp_view_decode(nullif('${cluster}','*')),mpp_view_decode(nullif('${database}','*')),mpp_view_decode(nullif('${user}','*')),'${timings:csv}','${base_order}',nullif('${min_samples}','')::bigint,${limit}) r\nCROSS JOIN LATERAL (SELECT max(x.last_at) last_at FROM mpp_query_hits('${norm}',r.fingerprint,r.scope_id,r.database,r.execution_user) x) h",
          "refId": "A"
        }
      ],
      "title": "SQL 身份排行：当前基线版本（最多 ${limit} 行）",
      "type": "table"
