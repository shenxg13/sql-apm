# Rendered by scripts/grafana/install.py; copy to /etc/systemd/system as root.
[Unit]
Description=SQL APM Grafana
After=network-online.target sql-apm-postgresql.service
Wants=network-online.target sql-apm-postgresql.service

[Service]
Type=simple
User=@USER@
WorkingDirectory=@GRAFANA@
ExecStart=@PYTHON@ @APP_ROOT@/scripts/grafana/install.py start --home @HOME@ --admin-password-file @ADMIN_PASSWORD_FILE@ --db-password-file @DB_PASSWORD_FILE@
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
