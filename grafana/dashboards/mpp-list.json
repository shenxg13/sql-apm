          "rawQuery": true,
          "rawSql": "/* mpp-list panel 3 A */ SELECT r.scope_id,r.database,r.execution_user,mpp_view_label('timing',coalesce(r.timing_type,'unknown')) timing,\n  r.record_count,r.not_success,r.total_ms,r.mean_ms,r.slowest_ms,r.last_at,r.fingerprint,r.ranked_rows,\n  '/d/mpp-detail/sql-detail?var-fp='||r.fingerprint||'&var-identity='||r.identity||'&from='||(extract(epoch FROM $__timeFrom()::timestamptz)*1000)::bigint||'&to='||(extract(epoch FROM $__timeTo()::timestamptz)*1000)::bigint||'&var-timing='||coalesce(r.timing_type,'unknown') AS url\nFROM mpp_view_ranking('${norm}',$__timeFrom()::timestamptz,$__timeTo()::timestamptz,mpp_view_decode(nullif('${cluster}','*')),mpp_view_decode(nullif('${database}','*')),mpp_view_decode(nullif('${user}','*')),'${timings:csv}','${rank_order}',${limit}) r",
          "refId": "A"
        }
