# Rendered by scripts/grafana/install.py; rerunning the installer overwrites this file.
# Grafana keeps its own accounts, folders and user dashboards in @HOME@/data/grafana.db.
app_mode = production

[paths]
data = @HOME@/data
logs = @HOME@/logs
plugins = @HOME@/plugins
provisioning = @HOME@/conf/provisioning

[server]
protocol = http
http_addr = @LISTEN@
http_port = @PORT@

[database]
type = sqlite3

[security]
admin_user = admin
admin_password = $__file{@ADMIN_PASSWORD_FILE@}
disable_gravatar = true

[users]
allow_sign_up = false
allow_org_create = false
default_language = zh-Hans

[auth]
disable_login_form = false

[auth.anonymous]
enabled = false

[analytics]
reporting_enabled = false
check_for_updates = false
check_for_plugin_updates = false

[plugins]
# Nothing is downloaded at start-up: Grafana 13 would otherwise fetch a default
# list of plugins from the internet. Every plugin comes from the pinned archives.
preinstall_disabled = true
# Signature checks stay on; no plugin is allowed unsigned.
allow_loading_unsigned_plugins =
plugin_admin_enabled = false
public_key_retrieval_disabled = true

[date_formats]
default_timezone = Asia/Shanghai

[news]
news_feed_enabled = false

[snapshots]
external_enabled = false

[log]
mode = file
