          "format": "table",
          "rawQuery": true,
          "rawSql": "/* mpp-status panel 1 A */ SELECT to_char(l.started_at AT TIME ZONE 'Asia/Shanghai','YYYY-MM-DD HH24:MI:SS') AS started FROM mpp_view_daily_last() l",
          "refId": "A"
        }
      ],
      "title": "上次运行开始于（北京时间）",
      "type": "stat"
    },
