        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sql-apm-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "/* mpp-list panel 1 A */ SELECT s.scope_id,min(f.first_log_at) first_at,max(f.last_log_at) last_at,count(*) files,'设为时间范围' AS action,\n  '/d/mpp-list/sql-list?from='||(extract(epoch FROM max(f.last_log_at)-interval '24 hours')*1000)::bigint||'&to='||(extract(epoch FROM max(f.last_log_at)+interval '1 second')*1000)::bigint AS url\nFROM scope s JOIN source_file f USING(scope_id) GROUP BY s.scope_id ORDER BY s.scope_id",
          "refId": "A"
        }
      ],
      "title": "数据的时间范围",
      "type": "table"
